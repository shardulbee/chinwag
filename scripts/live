#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
label=com.shardul.chinwag.live
plist="$HOME/Library/LaunchAgents/$label.plist"
installed="$HOME/.local/share/chinwag/live"
case "${1:-run}" in
  setup)
    "$root/scripts/fetch-native"
    [[ -x "$root/runtime/live-venv/bin/python" ]] || uv venv --python 3.12 "$root/runtime/live-venv"
    uv pip install --python "$root/runtime/live-venv/bin/python" -r "$root/live/requirements.txt"
    native="$root/artifacts/transcribe-native-macos-arm64-metal"
    xcrun clang -O2 -dynamiclib -I "$root/internal/transcribe" "$root/live/native.c" \
      -L "$native" -ltranscribe -Wl,-rpath,@loader_path/../artifacts/transcribe-native-macos-arm64-metal \
      -o "$root/runtime/live-native.dylib"
    ;;
  fetch-models)
    mkdir -p "$root/models/live"
    for model in nemotron-speech-streaming-en-0.6b nemotron-3.5-asr-streaming-0.6b \
                 parakeet-unified-en-0.6b moonshine-streaming-{tiny,small}; do
      file="$root/models/live/$model-Q8_0.gguf"
      [[ ! -s "$file" ]] || continue
      curl --fail --location --retry 2 --max-filesize 800000000 \
        "https://huggingface.co/handy-computer/$model-gguf/resolve/main/$model-Q8_0.gguf" -o "$file.part"
      mv "$file.part" "$file"
    done
    "$root/runtime/live-venv/bin/python" -c 'import sys; from pathlib import Path; from moonshine_voice import get_model_for_language, ModelArch; get_model_for_language("en", ModelArch.MEDIUM_STREAMING, cache_root=Path(sys.argv[1]))' "$root/models/moonshine-voice"
    ;;
  run)
    shift || true
    exec "$root/runtime/live-venv/bin/python" "$root/live/server.py" "$@"
    ;;
  install)
    mkdir -p "$HOME/Library/LaunchAgents" "$HOME/.local/state/chinwag"
    [[ ! -e "$plist" ]] || launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true
    # launchd must not read Documents (macOS privacy); models are hardlinked, not duplicated.
    mkdir -p "$installed/"{live,runtime,models/live,artifacts}
    cp "$root/live/server.py" "$installed/live/"
    cp "$root/runtime/live-native.dylib" "$installed/runtime/"
    cp -R "$root/artifacts/transcribe-native-macos-arm64-metal" "$installed/artifacts/"
    for file in "$root"/models/live/*.gguf; do [[ ! -f "$file" ]] || ln -f "$file" "$installed/models/live/"; done
    [[ ! -d "$root/models/moonshine-voice" ]] || cp -cR "$root/models/moonshine-voice" "$installed/models/"
    [[ -x "$installed/runtime/live-venv/bin/python" ]] || uv venv --python 3.12 "$installed/runtime/live-venv"
    uv pip install --python "$installed/runtime/live-venv/bin/python" -r "$root/live/requirements.txt"
    [[ ! -e "$plist" ]] || rm "$plist"
    plutil -create xml1 "$plist"
    plutil -insert Label -string "$label" "$plist"
    plutil -insert ProgramArguments -json "[\"$installed/runtime/live-venv/bin/python\",\"$installed/live/server.py\"]" "$plist"
    plutil -insert RunAtLoad -bool true "$plist"
    plutil -insert KeepAlive -bool true "$plist"
    plutil -insert StandardOutPath -string "$HOME/.local/state/chinwag/live.log" "$plist"
    plutil -insert StandardErrorPath -string "$HOME/.local/state/chinwag/live.log" "$plist"
    if ! launchctl bootstrap "gui/$(id -u)" "$plist"; then
      sleep 5 # A previous job may still be finishing shutdown after bootout.
      launchctl bootstrap "gui/$(id -u)" "$plist"
    fi
    ;;
  status)
    launchctl print "gui/$(id -u)/$label"
    curl --fail --silent http://127.0.0.1:3213/v1/live/models
    ;;
  stop) launchctl bootout "gui/$(id -u)/$label" ;;
  check) "$root/runtime/live-venv/bin/python" -m unittest discover -s "$root/tests/live" -v ;;
  *) echo "Usage: scripts/live {setup|fetch-models|run [--port 3213]|install|status|stop|check}" >&2; exit 2 ;;
esac
