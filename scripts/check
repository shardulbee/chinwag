#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

unformatted="$(gofmt -l cmd internal)"
if [[ -n "$unformatted" ]]; then
  echo "Go files need formatting:" >&2
  printf '%s\n' "$unformatted" >&2
  exit 1
fi

"$root/scripts/fetch-native"
native="$root/artifacts/transcribe-native-macos-arm64-metal"
export SDKROOT="$(xcrun --sdk macosx --show-sdk-path)"
export DYLD_LIBRARY_PATH="$native${DYLD_LIBRARY_PATH:+:$DYLD_LIBRARY_PATH}"
go vet ./...
go test ./...

arch="$(uname -m)"
xcrun swiftc \
  -swift-version 5 \
  -parse-as-library \
  -target "${arch}-apple-macos14.0" \
  -typecheck \
  -framework AppKit \
  -framework ApplicationServices \
  -framework AVFoundation \
  -framework Carbon \
  -framework CoreGraphics \
  -framework CryptoKit \
  -framework SwiftUI \
  macos/Chinwag/*.swift

bash -n scripts/build-app scripts/build-service scripts/check scripts/fetch-native scripts/service
plutil -lint macos/Chinwag/Info.plist >/dev/null
