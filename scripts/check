#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

"$root/scripts/fetch-native"
"$root/tests/engine/run.sh"
"$root/tests/http/run.sh"

arch="$(uname -m)"
xcrun swiftc \
  -swift-version 5 \
  -parse-as-library \
  -target "${arch}-apple-macos14.0" \
  -typecheck \
  -import-objc-header macos/Chinwag/Native/Chinwag-Bridging-Header.h \
  -framework AppKit \
  -framework ApplicationServices \
  -framework AVFoundation \
  -framework Carbon \
  -framework CoreGraphics \
  -framework CryptoKit \
  -framework SwiftUI \
  macos/Chinwag/*.swift

bash -n scripts/build-app scripts/check scripts/fetch-native scripts/service
plutil -lint macos/Chinwag/Info.plist >/dev/null
