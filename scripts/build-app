#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
configuration=release
signing_identity=""
force_adhoc=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --debug)
      configuration=debug
      shift
      ;;
    --sign)
      [[ -n "${2:-}" ]] || {
        echo "--sign requires a code-signing identity" >&2
        exit 2
      }
      signing_identity="$2"
      shift 2
      ;;
    --adhoc)
      force_adhoc=1
      shift
      ;;
    *)
      echo "Usage: scripts/build-app [--debug] [--adhoc | --sign IDENTITY]" >&2
      exit 2
      ;;
  esac
done
[[ "$force_adhoc" != 1 || -z "$signing_identity" ]] || {
  echo "--adhoc and --sign cannot be used together" >&2
  exit 2
}

app="$root/dist/Chinwag.app"
mkdir -p "$root/dist"
touch "$root/dist/.metadata_never_index"
contents="$app/Contents"
executable="$contents/MacOS/Chinwag"
resources="$contents/Resources"
rm -rf "$app"
mkdir -p "$contents/MacOS" "$resources"
cp "$root/macos/Chinwag/Info.plist" "$contents/Info.plist"
plutil -lint "$contents/Info.plist" >/dev/null

icon_tmp="$(mktemp -d)"
trap 'rm -rf "$icon_tmp"' EXIT
catalog="$icon_tmp/Assets.xcassets"
app_icon="$catalog/AppIcon.appiconset"
mkdir -p "$app_icon"
printf '{"info":{"author":"xcode","version":1}}\n' > "$catalog/Contents.json"
cat > "$app_icon/Contents.json" <<'JSON'
{
  "images": [
    {"filename":"icon_16x16.png","idiom":"mac","scale":"1x","size":"16x16"},
    {"filename":"icon_16x16@2x.png","idiom":"mac","scale":"2x","size":"16x16"},
    {"filename":"icon_32x32.png","idiom":"mac","scale":"1x","size":"32x32"},
    {"filename":"icon_32x32@2x.png","idiom":"mac","scale":"2x","size":"32x32"},
    {"filename":"icon_128x128.png","idiom":"mac","scale":"1x","size":"128x128"},
    {"filename":"icon_128x128@2x.png","idiom":"mac","scale":"2x","size":"128x128"},
    {"filename":"icon_256x256.png","idiom":"mac","scale":"1x","size":"256x256"},
    {"filename":"icon_256x256@2x.png","idiom":"mac","scale":"2x","size":"256x256"},
    {"filename":"icon_512x512.png","idiom":"mac","scale":"1x","size":"512x512"},
    {"filename":"icon_512x512@2x.png","idiom":"mac","scale":"2x","size":"512x512"}
  ],
  "info":{"author":"xcode","version":1}
}
JSON
icon_source="$root/macos/Chinwag/Assets/ChinwagIcon.png"
icon_specs=(
  "16 icon_16x16.png"
  "32 icon_16x16@2x.png"
  "32 icon_32x32.png"
  "64 icon_32x32@2x.png"
  "128 icon_128x128.png"
  "256 icon_128x128@2x.png"
  "256 icon_256x256.png"
  "512 icon_256x256@2x.png"
  "512 icon_512x512.png"
  "1024 icon_512x512@2x.png"
)
for spec in "${icon_specs[@]}"; do
  read -r size filename <<< "$spec"
  sips -z "$size" "$size" "$icon_source" --out "$app_icon/$filename" >/dev/null
done
xcrun actool "$catalog" \
  --compile "$resources" \
  --platform macosx \
  --minimum-deployment-target 14.0 \
  --app-icon AppIcon \
  --output-partial-info-plist "$icon_tmp/asset-info.plist" \
  --warnings \
  --errors \
  --output-format human-readable-text >/dev/null
cp "$root/macos/Chinwag/Assets/ChinwagMenuTemplate.png" "$resources/"
cp "$root/macos/Chinwag/Assets/ChinwagMenuTemplate@2x.png" "$resources/"

arch="$(uname -m)"
compile_flags=(-swift-version 5 -parse-as-library -target "${arch}-apple-macos14.0")
if [[ "$configuration" == debug ]]; then
  compile_flags+=(-D DEBUG -Onone -g)
else
  compile_flags+=(-O)
fi

sources=("$root"/macos/Chinwag/*.swift)
xcrun swiftc \
  "${compile_flags[@]}" \
  -framework AppKit \
  -framework ApplicationServices \
  -framework AVFoundation \
  -framework Carbon \
  -framework CoreGraphics \
  -framework CryptoKit \
  -framework SwiftUI \
  "${sources[@]}" \
  -o "$executable"

if [[ "$force_adhoc" == 1 ]]; then
  signing_identity="-"
elif [[ -z "$signing_identity" ]]; then
  installed_app="$HOME/Applications/Chinwag.app"
  installed_identity="$(codesign -dvv "$installed_app" 2>&1 \
    | awk -F= '/^Authority=/{print substr($0, index($0, "=") + 1); exit}' || true)"
  identities="$(security find-identity -v -p codesigning 2>/dev/null || true)"
  if [[ -n "$installed_identity" && "$identities" == *"\"$installed_identity\""* ]]; then
    signing_identity="$installed_identity"
  else
    signing_identity="-"
  fi
fi

if [[ "$signing_identity" == "-" ]]; then
  codesign --force --sign - --timestamp=none "$app" >/dev/null
  printf '%s\n' "$app"
  exit 0
fi

identities="$(security find-identity -v -p codesigning 2>/dev/null || true)"
[[ "$identities" == *"\"$signing_identity\""* ]] || {
  printf 'Code-signing identity not found: %s\n' "$signing_identity" >&2
  exit 1
}
sign_error="$icon_tmp/codesign.error"
if codesign --force --sign "$signing_identity" --timestamp=none "$app" 2>"$sign_error"; then
  printf '%s\n' "$app"
  exit 0
fi

# Background build sessions cannot display Keychain prompts. Retry the same
# narrowly scoped signing command in the logged-in GUI session.
signer="$icon_tmp/ChinwagSigner.app"
mkdir -p "$signer/Contents/MacOS"
{
  echo '#!/bin/bash'
  printf 'exec /usr/bin/codesign --force --sign %q --timestamp=none %q\n' \
    "$signing_identity" "$app"
} > "$signer/Contents/MacOS/ChinwagSigner"
chmod +x "$signer/Contents/MacOS/ChinwagSigner"
cat > "$signer/Contents/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleExecutable</key><string>ChinwagSigner</string>
<key>CFBundleIdentifier</key><string>com.chinwag.signing-helper</string>
<key>CFBundleName</key><string>Chinwag Signing Helper</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>LSUIElement</key><true/>
</dict></plist>
PLIST
codesign --force --sign - --timestamp=none "$signer" >/dev/null
if ! open -n "$signer"; then
  cat "$sign_error" >&2
  printf 'Could not open the Chinwag signing helper.\n' >&2
  exit 1
fi
for _ in {1..1200}; do
  if codesign --verify --deep --strict "$app" 2>/dev/null \
    && codesign -dvv "$app" 2>&1 | grep -F "Authority=$signing_identity" >/dev/null; then
    printf '%s\n' "$app"
    exit 0
  fi
  sleep 0.1
done
cat "$sign_error" >&2
printf 'Could not sign Chinwag with %s.\n' "$signing_identity" >&2
exit 1
