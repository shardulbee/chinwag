#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
engine_label="com.shardul.chinwag.service"
menu_label="com.shardul.chinwag.menu"
engine_plist="$HOME/Library/LaunchAgents/$engine_label.plist"
menu_plist="$HOME/Library/LaunchAgents/$menu_label.plist"
state_dir="$HOME/.local/state/chinwag"
runtime_dir="$HOME/.local/share/chinwag/runtime"
installed_app="$HOME/Applications/Chinwag.app"
built_service="$root/dist/chinwag-service"
built_library_dir="$root/dist/lib"

usage() {
  echo "Usage: scripts/service {run|install [--adhoc | --sign IDENTITY]|status|uninstall}" >&2
  exit 2
}

run_service() {
  [[ -x "$built_service" && -s "$built_library_dir/libtranscribe.dylib" ]] || {
    echo "Build the Go service first with scripts/build-service" >&2
    exit 1
  }
  exec "$built_service"
}

new_plist() {
  local path="$1"
  rm -f "$path"
  plutil -create xml1 "$path"
  chmod 600 "$path"
}

plist_string() {
  plutil -insert "$2" -string "$3" "$1"
}

plist_bool() {
  plutil -insert "$2" -bool "$3" "$1"
}

plist_array() {
  local path="$1" key="$2"
  shift 2
  plutil -insert "$key" -array "$path"
  for value in "$@"; do plutil -insert "$key" -string "$value" -append "$path"; done
}

install_agents() {
  [[ "$(uname -s)" == "Darwin" ]] || {
    echo "LaunchAgent installation requires macOS" >&2
    exit 1
  }
  "$root/scripts/build-service" >/dev/null
  if [[ $# -gt 0 ]]; then
    "$root/scripts/build-app" "$@" >/dev/null
  else
    "$root/scripts/build-app" >/dev/null
  fi

  mkdir -p "$HOME/Library/LaunchAgents" "$HOME/Applications" "$state_dir"
  chmod 700 "$state_dir"
  rm -rf "$runtime_dir"
  mkdir -p "$runtime_dir/lib"
  chmod 700 "$runtime_dir" "$runtime_dir/lib"
  cp "$built_service" "$runtime_dir/chinwag-service"
  ditto "$built_library_dir" "$runtime_dir/lib"
  chmod 700 "$runtime_dir/chinwag-service"

  rm -rf "$installed_app"
  ditto "$root/dist/Chinwag.app" "$installed_app"
  rm -rf "$root/dist/Chinwag.app"
  local lsregister="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"
  "$lsregister" -f "$installed_app" >/dev/null 2>&1 || true
  mdimport -i "$installed_app" >/dev/null 2>&1 || true

  new_plist "$engine_plist"
  plist_string "$engine_plist" Label "$engine_label"
  plist_array "$engine_plist" ProgramArguments "$runtime_dir/chinwag-service"
  plist_string "$engine_plist" WorkingDirectory "$runtime_dir"
  plist_bool "$engine_plist" RunAtLoad true
  plist_bool "$engine_plist" KeepAlive true
  plist_string "$engine_plist" ProcessType Interactive
  plist_string "$engine_plist" StandardOutPath "$state_dir/service.log"
  plist_string "$engine_plist" StandardErrorPath "$state_dir/service.log"
  plutil -insert ThrottleInterval -integer 5 "$engine_plist"

  new_plist "$menu_plist"
  plist_string "$menu_plist" Label "$menu_label"
  plist_array "$menu_plist" ProgramArguments "$installed_app/Contents/MacOS/Chinwag"
  plist_bool "$menu_plist" RunAtLoad true
  plist_string "$menu_plist" ProcessType Interactive
  plist_string "$menu_plist" LimitLoadToSessionType Aqua
  plist_string "$menu_plist" StandardOutPath "$state_dir/menu.log"
  plist_string "$menu_plist" StandardErrorPath "$state_dir/menu.log"

  local domain="gui/$(id -u)"
  launchctl bootout "$domain/$engine_label" 2>/dev/null || true
  launchctl bootout "$domain/$menu_label" 2>/dev/null || true
  sleep 1
  if ! launchctl bootstrap "$domain" "$engine_plist"; then
    sleep 1
    launchctl bootstrap "$domain" "$engine_plist"
  fi
  if ! launchctl bootstrap "$domain" "$menu_plist"; then
    sleep 1
    launchctl bootstrap "$domain" "$menu_plist"
  fi
  launchctl kickstart "$domain/$engine_label"
  launchctl kickstart "$domain/$menu_label"

  local engine_pid health ready=0
  for _ in {1..60}; do
    engine_pid="$(launchctl print "$domain/$engine_label" 2>/dev/null \
      | awk '/^[[:space:]]*pid =/{print $3; exit}')"
    health="$(curl --silent --max-time 1 \
      "http://127.0.0.1:3212/healthz" 2>/dev/null || true)"
    if [[ -n "$engine_pid" && "$health" == *"\"pid\":$engine_pid"* \
      && ( "$health" == *'"state":"ready"'* || "$health" == *'"state":"loading"'* ) ]]; then
      ready=1
      break
    fi
    sleep 0.5
  done
  if [[ "$ready" != 1 ]]; then
    echo "LaunchAgents were installed, but the transcription service did not become ready." >&2
    echo "Inspect $state_dir/service.log and run scripts/service status." >&2
    return 1
  fi

  echo "Installed $installed_app"
  echo "Transcription service: http://127.0.0.1:3212"
}

status_agents() {
  local domain="gui/$(id -u)"
  launchctl print "$domain/$engine_label" 2>/dev/null \
    | grep -E '^\s*(state|pid|last exit code) =' || true
  launchctl print "$domain/$menu_label" 2>/dev/null \
    | grep -E '^\s*(state|pid|last exit code) =' || true
  curl --fail --silent --show-error "http://127.0.0.1:3212/healthz" || true
  echo
}

uninstall_agents() {
  local domain="gui/$(id -u)"
  launchctl bootout "$domain/$engine_label" 2>/dev/null || true
  launchctl bootout "$domain/$menu_label" 2>/dev/null || true
  rm -f "$engine_plist" "$menu_plist"
  rm -rf "$installed_app" "$runtime_dir"
  echo "Removed the Chinwag LaunchAgents, runtime, and menu-bar app"
}

command="${1:-}"
shift || true
case "$command" in
  run) [[ $# == 0 ]] || usage; run_service ;;
  install) install_agents "$@" ;;
  status) [[ $# == 0 ]] || usage; status_agents ;;
  uninstall) [[ $# == 0 ]] || usage; uninstall_agents ;;
  *) usage ;;
esac
